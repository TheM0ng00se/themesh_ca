---
import { Picture } from "astro:assets";
import heroImage from "@/assets/main-banner-white.jpg";
import Link from "@/components/ui/link.astro";
import { Icon } from "astro-icon/components";
---

<main
  class="grid lg:grid-cols-2 place-items-center pt-16 pb-8 md:pt-12 md:pb-24">
  <div class="py-6 md:order-1 hidden md:block">
    <Picture
      src={heroImage}
      alt="Cloud infrastructure and cybersecurity illustration"
      widths={[400, 700, 1000]}
      sizes="(max-width: 800px) 100vw, 620px"
      loading="eager"
      format="avif"
      class="w-full h-auto mix-blend-multiply"
    />
  </div>
  <div>
    <h1
      class="text-5xl lg:text-6xl xl:text-7xl font-bold lg:tracking-tight xl:tracking-tighter">
      Scale your cloud efficiently.
    </h1>
    <p class="text-lg mt-4 text-slate-600 max-w-xl">
      At Mesh, we bring extensive experience managing a diverse portfolio of clients. This enables us to design and build your cloud environment in a way that is simple, secure, and cost-effective.
    </p>
    <div class="mt-6 flex flex-col sm:flex-row gap-3">
      <Link href="/clients" class="flex gap-1 items-center justify-center">
        See our Clients
      </Link>
    </div>
  </div>
</main>
