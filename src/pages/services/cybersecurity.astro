---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import { Icon } from "astro-icon/components";

const services = [
  {
    title: "Cloud Security Assessments",
    description:
      "Get a clear picture of your cloud security posture with thorough assessments that surface risks and deliver actionable remediation plans.",
    icon: "bx:bxs-shield-alt-2",
  },
  {
    title: "Compliance",
    description:
      "Navigate complex regulatory requirements with confidence. We help you achieve and maintain compliance across frameworks like SOC 2, ISO 27001, and more.",
    icon: "bx:bxs-check-shield",
  },
  {
    title: "Operational Sustainability",
    description:
      "Most security problems don't appear out of nowhere — they slip through because they're caught too late. We help organizations build guardrails and shift security left, so issues are flagged earlier in the development cycle and your team spends less time fighting fires.",
    icon: "bx:bxs-cog",
  },
];
---

<Layout title="Cybersecurity">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Cybersecurity</Fragment>
      <Fragment slot="desc">
        We help you understand your risk, close the gaps, and stay compliant — so your business stays protected. Whether you need to maintain compliance frameworks such as PCI, SOC2, GDPR, ISO27001, or you simply want peace of mind knowing your environments are secure, our team is ready to help you get there.
      </Fragment>
    </Sectionhead>

    <div class="flex flex-col gap-10 mt-16 max-w-4xl mx-auto">
      {services.map((item) => (
        <div class="flex gap-4 items-start">
          <div class="mt-1 bg-black rounded-full p-2 w-8 h-8 shrink-0">
            <Icon class="text-white" name={item.icon} />
          </div>
          <div>
            <h3 class="font-semibold text-lg">{item.title}</h3>
            <p class="text-slate-500 mt-2 leading-relaxed">{item.description}</p>
          </div>
        </div>
      ))}
    </div>
  </Container>
</Layout>
