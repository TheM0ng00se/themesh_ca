---
import Contactform from "@/components/contactform.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import Layout from "@/layouts/Layout.astro";
import { Icon } from "astro-icon/components";
---

<Layout title="Contact">
  <Container>
    <Sectionhead>
      <Fragment slot="title">How to Reach Us</Fragment>
      <Fragment slot="desc">Reach out through the form below or for general inquiries contact us directly.</Fragment>
    </Sectionhead>

    <div class="grid md:grid-cols-2 gap-10 mx-auto max-w-4xl mt-16">
      <div>
        <h2 class="font-bold text-4xl text-gray-800">Drop us a Line</h2>
        <p class="text-lg leading-relaxed text-slate-500 mt-3">
          Let us know how we can help. No question is too big or small. Someone will follow up with you!
        </p>
        <div class="mt-5">
          <div class="flex items-start mt-2 space-x-2 text-gray-600">
            <Icon class="text-gray-400 w-4 h-4 mt-1 shrink-0" name="uil:map-marker" />
            <address class="not-italic leading-relaxed">
              610-100 Esplanade East<br />
              North Vancouver, BC<br />
              Canada, V7L 4V1
            </address>
          </div>
          <div class="flex items-center mt-2 space-x-2 text-gray-600">
            <Icon class="text-gray-400 w-4 h-4" name="uil:envelope" />
            <a href="mailto:general-inquiries@themesh.ca">general-inquiries@themesh.ca</a>
          </div>
        </div>
      </div>
      <div>
        <Contactform />
      </div>
    </div>
  </Container>
</Layout>
